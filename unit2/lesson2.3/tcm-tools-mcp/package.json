{
  "name": "tcm-tools-mcp",
  "version": "0.1.0",
  "description": "MCP Server for TCM formulas (fangji) and herbs (yaocai) with Provider abstraction",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "tcm-tools-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "data"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "prepare": "npm run build",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "tcm",
    "traditional-chinese-medicine",
    "fangji",
    "prescription",
    "herb",
    "yaocai",
    "provider",
    "model-context-protocol"
  ],
  "license": "MIT"
}